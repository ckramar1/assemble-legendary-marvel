    "schemes": [
      {
        "name": "Breach_The_Nexus_Of_All_Realities",
        "displayName": "Breach The Nexus Of All Realities",
        "postRandomization": {
          "schemeTwists": 0,
          "notes": [
            "Stack each Villain Group separately face down as its own \"Reality.\" Add 2 Twists to each Reality.",
            "Shuffle together all the Henchmen, Master Strikes, and Bystanders for your player count and randomly distribute them amongst all the Realities, as evenly as possible. Shuffle each Reality separately."
          ],
          "conditionalRules": [
            {
              "parameter": "numberOfPlayers",
              "conditions": {
                "1-2": {
                  "villains": {
                    "set": {
                      "count": 3
                    },
                    "priority": 5
                  }
                }
              }
            }
          ]
        }
      },
      {
        "name": "Collect_An_Interstellar_Zoo",
        "displayName": "Collect An Interstellar Zoo",
        "postRandomization": {
          "schemeTwists": 11
        }
      },
      {
        "name": "Marvel_Zombies",
        "displayName": "Marvel Zombies",
        "postRandomization": {
          "schemeTwists": 4,
          "villains": {
            "forceInclude": [
              "Zombie_Avengers"
            ],
            "priority": 15
          },
          "dynamicNotes": [
            {
              "template": "Add 8 random cards from an extra Hero ({extraHero}) to the Villain Deck.",
              "variables": {
                "extraHero": {
                  "type": "randomUnusedElementOfType",
                  "elementType": "heroes"
                }
              }
            }
          ],
          "conditionalRules": [
            {
              "parameter": "numberOfPlayers",
              "conditions": {
                "1": {
                  "bystanders": 4
                },
                "2": {
                  "bystanders": 5
                }
              }
            }
          ]
        }
      },
