            },
            {
                "name": "Dark Alliance",
                "schemeTwists": 8,
                "displayName": "Dark Alliance"
            },
            {
                "name": "Fragmented Realities",
                "postRandomization": {
                    "villains": {
                        "addExtra": 1
                    },
                    "notes": [
                        "Shuffle the Villain Deck, then split it as evenly as possible into a Villain Deck for each player. Then, shuffle 2 Twists into each player's Villain Deck."
                    ]
                },
                "displayName": "Fragmented Realities"
            },
            {
                "name": "Master Of Tyrants",
                "schemeTwists": 8,
                "postRandomization": {
                    "dynamicNotes": [
                        {
                            "template": "Choose 3 other Masterminds ({mastermind1}, {mastermind2} and {mastermind3}), and shuffle their 12 Tactics into the Villain Deck. Those Tactics are 'Tyrant Villains' with their printed Attack and no abilities.",
