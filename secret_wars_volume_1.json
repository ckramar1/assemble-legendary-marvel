                                "mastermind1": {
                                    "type": "randomUnusedElementOfType",
                                    "elementType": "masterminds"
                                },
                                "mastermind2": {
                                    "type": "randomUnusedElementOfType",
                                    "elementType": "masterminds"
                                },
                                "mastermind3": {
