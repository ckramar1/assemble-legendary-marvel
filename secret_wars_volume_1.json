                "name": "Build An Army Of Annihilation",
                "schemeTwists": 9,
                "postRandomization": {
                    "dynamicNotes": [
                        {
                            "template": "Put 10 extra Annihilation Wave Henchmen ({selectedHenchman}) in the KO pile.",
                            "variables": {
                                "selectedHenchman": {
                                    "type": "randomUnusedElementOfType",
                                    "elementType": "henchmen"
                                }
                            }
                        }
                    ]
                },
                "displayName": "Build An Army Of Annihilation"
            },
            {
                "name": "Corrupt The Next Generation Of Heroes",
                "schemeTwists": 8,
                "postRandomization": {
                    "notes": [
                        "Add 10 Sidekicks to the Villain Deck."
                    ]
                },
                "displayName": "Corrupt The Next Generation Of Heroes"
            },
            {
                "name": "Pan-Dimensional Plague",
                "schemeTwists": 10,
                "displayName": "Pan-Dimensional Plague"
            },
            {
                "name": "Smash Two Dimensions Together",
                "schemeTwists": 8,
                "postRandomization": {
                    "villains": {
                        "addExtra": 1
                    },
                    "boards": {
                        "forceIncludeMatching": {
                            "matching": [
                                "Hero"
                            ]
                        },
                        "priority": 5
                    },
                    "notes": [
                        "Put the Villain Deck on the Bank space."
                    ]
                },
                "displayName": "Smash Two Dimensions Together"
            },
            {
                "name": "Crush Them With My Bare Hands",
                "schemeTwists": 5,
                "postRandomization": {
                    "conditionalRules": [
                        {
                            "parameter": "numberOfPlayers",
                            "conditions": {
                                "1": {
                                    "villains": {
                                        "addExtra": 1
                                    }
                                }
                            }
                        }
                    ]
                },
